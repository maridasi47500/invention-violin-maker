# app/models/lutherie.rb
class Lutherie < ApplicationRecord
  has_many :violon_achats
  has_many :enregistrement_musicaux, foreign_key: :lutherie_violon_id
  has_many :enregistrement_musicaux, foreign_key: :lutherie_archet_id
  belongs_to :epoque_dominante, class_name: 'Epoque', optional: true
  
  validates :nom, :ville, :pays, presence: true
  
  enum type_lutherie: { violon: 0, archet: 1, both: 2 }
  
  # "Violons Crémone" = souvenir d'Italie
  scope :touristique, -> { where(produit_touristique: true) }
  scope :par_ville, ->(ville) { where(ville: ville) }
  scope :par_epoque, ->(epoque) { where(epoque_dominante_id: epoque.id) }
end

# app/models/violon_achat.rb
class ViolonAchat < ApplicationRecord
  belongs_to :lutherie
  has_many :souvenirs, dependent: :destroy
  has_many :enregistrement_musicaux, through: :souvenirs
  has_many :session_jeus, dependent: :destroy
  
  validates :date_achat, :prix_paye_eur, presence: true
  
  # "Mon souvenir de Crémone"
  def description_souvenir
    "#{lutherie.nom} acheté à #{lieu_achat_ville} le #{date_achat.strftime('%d/%m/%Y')}"
  end
end

# app/models/enregistrement_musical.rb
class EnregistrementMusical < ApplicationRecord
  belongs_to :oeuvre
  belongs_to :violoniste, class_name: 'Compositeur'
  belongs_to :lutherie_violon, class_name: 'Lutherie', optional: true
  belongs_to :lutherie_archet, class_name: 'Lutherie', optional: true
  belongs_to :epoque_compositeur, class_name: 'Epoque'
  belongs_to :epoque_enregistrement, class_name: 'Epoque', optional: true
  has_many :souvenirs, dependent: :destroy
  
  # "Heifetz joue Bach avec un Strad et un archet Tourte"
  def lutherie_complete
    "#{lutherie_violon&.nom || 'Inconnu'} + #{lutherie_archet&.nom || 'Inconnu'}"
  end
end

# app/models/session_jeu.rb
class SessionJeu < ApplicationRecord
  belongs_to :violon_achat
  has_many :souvenirs
  
  # "Aujourd'hui j'ai joué Bach sur mon Cremonese"
end

# app/models/souvenir.rb
class Souvenir < ApplicationRecord
  belongs_to :violon_achat
  belongs_to :enregistrement_musical
  belongs_to :session_jeu, optional: true
  
  # Le VRAI lien : tu achètes un violon → tu écoutes de la musique sur ce violon
  # → tu joues cette musique → c'est UN SOUVENIR
end
# db/migrate/[timestamp]_create_lutheries.rb
class CreateLutheries < ActiveRecord::Migration[7.0]
  def change
    create_table :lutheries do |t|
      # Identification
      t.string :nom, null: false                    # "Cremonese", "Parisian Archet", "Mittenwald"
      t.string :ville, null: false                  # "Cremona", "Paris", "Mittenwald"
      t.string :region                              # "Lombardy", "Île-de-France"
      t.string :pays, null: false                   # "Italy", "France", "Germany"
      
      # Type de lutherie
      t.integer :type_lutherie                      # enum: violon, archet, both
      
      # Caractéristiques
      t.text :description_typique                   # "Warm, dark sonority, golden sheen"
      t.text :materiel_caracteristique              # "Spruce from Val di Fiemme, maple from Balkan"
      
      # Historique
      t.integer :periode_fondation_debut            # 1650
      t.integer :periode_fondation_fin              # 1850
      t.integer :epoque_dominante_id                # FK Epoque (Baroque, Classique, etc.)
      
      # Commercialisation
      t.boolean :disponible_achat_neuf, default: true
      t.boolean :disponible_occasion, default: true
      t.integer :prix_approximatif_eur              # 2026 pricing
      t.string :plateforme_achat                    # "EBAY", "Luthier direct", "Auction"
      
      # Statut culturel/touristique
      t.boolean :produit_touristique, default: true # "T-shirt violin"
      t.text :heritage_culturel                     # "UNESCO Living Heritage", "Master Craftsmen"
      
      t.timestamps
    end
    
    add_index :lutheries, [:ville, :pays], unique: true
    add_foreign_key :lutheries, :epoques, column: :epoque_dominante_id
  end
end

# db/migrate/[timestamp]_create_violon_achats.rb
