      t.integer :annee_fabrication                  # Quand le violon a été fait
      
      # État de la collection
      t.boolean :actif_collection, default: true
      t.date :date_vente_ulterieure                 # Si revendu après
      
      t.timestamps
    end
    
    add_foreign_key :violon_achats, :lutheries
  end
end

# db/migrate/[timestamp]_create_enregistrement_musicaux.rb
class CreateEnregistrementMusicals < ActiveRecord::Migration[7.0]
  def change
    create_table :enregistrement_musicaux do |t|
      t.references :oeuvre, null: false, foreign_key: true
      t.references :violoniste, null: false         # Violinist performer
      
      # Enregistrement = achat/collection
      t.date :date_enregistrement                   # Quand c'est gravé
      t.string :format_media                        # "vinyl", "CD", "streaming", "radio"
      t.string :label_editeur                       # "Deutsche Grammophon", "Naxos"
      t.string :url_streaming                       # Spotify, YouTube link
      
      # Lutherie utilisée par le violoniste
      t.references :lutherie_violon, foreign_key: { to_table: :lutheries }, optional: true
      t.references :lutherie_archet, foreign_key: { to_table: :lutheries }, optional: true
      t.text :notes_lutherie                        # "Used Strad 1715, Tourte archet"
      
      # Source/possession
      t.string :source_achat                        # "eBay", "Discogs", "Spotify", "Héritage familial"
      t.date :date_achat_ou_decouverte
      
      # Contexte
      t.integer :epoque_compositeur_id              # L'époque du compositeur
      t.integer :epoque_enregistrement_id           # L'époque où c'a été gravé (peut être différent!)
      
      t.timestamps
    end
    
    add_foreign_key :enregistrement_musicaux, :oeuvres
    add_foreign_key :enregistrement_musicaux, :compositeurs, column: :violoniste_id
    add_foreign_key :enregistrement_musicaux, :epoques, column: :epoque_compositeur_id
    add_foreign_key :enregistrement_musicaux, :epoques, column: :epoque_enregistrement_id
  end
end

# db/migrate/[timestamp]_create_session_jeus.rb
class CreateSessionJeus < ActiveRecord::Migration[7.0]
