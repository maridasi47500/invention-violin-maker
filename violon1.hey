      t.integer :ressenti_epoque                    # 1-10 : how much did you "feel" the epoch?
      t.text :reflexion_personnelle                 # "Playing on Cremonese made me feel Baroque soul"
      
      t.timestamps
    end
  end
end

# db/migrate/[timestamp]_create_souvenirs.rb
# LIEN : Violon acheté ↔ Musique écoutée ↔ Session de jeu
class CreateSouvenirs < ActiveRecord::Migration[7.0]
  def change
    create_table :souvenirs do |t|
      t.references :violon_achat, null: false, foreign_key: true
      t.references :enregistrement_musical, null: false, foreign_key: true
      t.references :session_jeu, optional: true, foreign_key: true
      
      # Expérience
      t.date :date_ecoute                           # Quand tu l'as écouté
      t.text :contexte                              # "Écouté à Cremona après l'achat du violon"
      t.text :reflexion                             # "C'est avec CE violon que je veux jouer ça"
      
      # Le "souvenir" est-il vivant ?
      t.boolean :relie_à_jeu_personnel, default: false  # As-tu joué cette pièce?
      t.integer :resonance_emotionnelle             # 1-10 : how connected?
      
      t.timestamps
    end
    
    add_index :souvenirs, [:violon_achat_id, :enregistrement_musical_id], unique: true
