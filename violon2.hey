class CreateLutheries < ActiveRecord::Migration[6.0]
  def change
    create_table :lutheries do |t|
      t.string :nom, null: false
      t.string :luthier_name
      t.references :epoque, null: false, foreign_key: true
      t.integer :type_lutherie, default: 0
      t.integer :annee_creation
      t.string :region
      t.text :materials
      t.text :caracteristiques_sonores
      t.text :notes
      t.timestamps
    end
    add_index :lutheries, [:nom, :epoque_id], unique: true
  end
end
