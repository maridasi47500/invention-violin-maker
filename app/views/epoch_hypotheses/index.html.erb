<p style="color: green"><%= notice %></p>

<% content_for :title, "Epoch hypotheses" %>

<h1>Epoch hypotheses</h1>

<div id="epoch_hypotheses">
  <% @epoch_hypotheses.each do |epoch_hypothesis| %>
    <%= render epoch_hypothesis %>
    <p>
      <%= link_to "Show this epoch hypothesis", epoch_hypothesis %>
    </p>
  <% end %>
</div>

<%= link_to "New epoch hypothesis", new_epoch_hypothesis_path %>
