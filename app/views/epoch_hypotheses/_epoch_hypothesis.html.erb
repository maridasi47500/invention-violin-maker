<div id="<%= dom_id epoch_hypothesis %>">
  <p>
    <strong>Experience:</strong>
    <%= epoch_hypothesis.experience_id %>
  </p>

  <p>
    <strong>Epoch detected:</strong>
    <%= epoch_hypothesis.epoch_detected %>
  </p>

  <p>
    <strong>Bow stroke hypothesis:</strong>
    <%= epoch_hypothesis.bow_stroke_hypothesis %>
  </p>

  <p>
    <strong>Confidence percent:</strong>
    <%= epoch_hypothesis.confidence_percent %>
  </p>

  <p>
    <strong>Reason:</strong>
    <%= epoch_hypothesis.reason %>
  </p>

</div>
