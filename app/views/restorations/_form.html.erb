<%= form_with(model: restoration) do |form| %>
  <% if restoration.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(restoration.errors.count, "error") %> prohibited this restoration from being saved:</h2>

      <ul>
        <% restoration.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :instrument_id, style: "display: block" %>
    <%= form.select :instrument_id, Instrument.all.collect{|g|[g.brand+ " "+g.model+" "+g.year.to_s, g.id]} %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.textarea :description %>
  </div>

  <div>
    <%= form.label :work_date, style: "display: block" %>
    <%= form.date_field :work_date %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
