<%= form_with(model: souvenir) do |form| %>
  <% if souvenir.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(souvenir.errors.count, "error") %> prohibited this souvenir from being saved:</h2>

      <ul>
        <% souvenir.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :instrument_id, "mon instrument", style: "display: block" %>
    <%= form.collection_select :instrument_id,Instrument.all, :id, :myname %>
  </div>

  <div>
    <%= form.label :enregistrement_musical_id,"piece que je veux jouer",  style: "display: block" %>
    <%= form.collection_select :enregistrement_musical_id,EnregistrementMusical.all, :id, :myname %>
  </div>

  <div>
    <%= form.label :session_jeu_id,"ma session de jeu", style: "display: block" %>
    <%= form.collection_select :session_jeu_id,SessionJeu.all, :id, :myname %>
  </div>

  <div>
    <%= form.label :date_ecoute, style: "display: block" %>
    <%= form.date_field :date_ecoute %>
  </div>

  <div>
    <%= form.label :contexte, style: "display: block" %>
    <%= form.textarea :contexte %>
  </div>

  <div>
    <%= form.label :reflexion, style: "display: block" %>
    <%= form.textarea :reflexion %>
  </div>

  <div>
    <%= form.label :resonnace_emotionnelle, style: "display: block" %>
    <%= form.number_field :resonnace_emotionnelle %>
  </div>

  <div>
    <%= form.label :piece_deja_jouee, style: "display: block" %>
    <%= form.checkbox :piece_deja_jouee %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
