<div id="<%= dom_id epoch_validation %>">
  <p>
    <strong>Epoch hypothesis:</strong>
    <%= epoch_validation.epoch_hypothesis_id %>
  </p>

  <p>
    <strong>Actual bow stroke:</strong>
    <%= epoch_validation.actual_bow_stroke %>
  </p>

  <p>
    <strong>Matches hypothesis:</strong>
    <%= epoch_validation.matches_hypothesis %>
  </p>

  <p>
    <strong>Discrepancy:</strong>
    <%= epoch_validation.discrepancy %>
  </p>

</div>
