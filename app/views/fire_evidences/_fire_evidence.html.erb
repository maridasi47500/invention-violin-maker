<div id="<%= dom_id fire_evidence %>">
  <p>
    <strong>Fire point:</strong>
    <%= fire_evidence.fire_point_id %>
  </p>

  <p>
    <strong>Evidence type:</strong>
    <%= fire_evidence.evidence_type %>
  </p>

  <p>
    <strong>Source:</strong>
    <%= fire_evidence.source %>
  </p>

  <p>
    <strong>Content:</strong>
    <%= fire_evidence.content %>
  </p>

  <p>
    <strong>Source url:</strong>
    <%= fire_evidence.source_url %>
  </p>

  <p>
    <strong>Confidence:</strong>
    <%= fire_evidence.confidence %>
  </p>

</div>
