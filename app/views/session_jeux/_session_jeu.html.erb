<div id="<%= dom_id session_jeu %>">
  <p>
    <strong>Instrument:</strong>
    <%= session_jeu.instrument.myname %>
  </p>

  <p>
    <strong>Date session:</strong>
    <%= session_jeu.date_session %>
  </p>

  <p>
    <strong>Heure debut:</strong>
    <%= I18n.l(session_jeu.heure_debut, format: :short) %>
  </p>

  <p>
    <strong>Duree minutes:</strong>
    <%= session_jeu.duree_minutes %>
  </p>

  <p>
    <strong>Pieces jouees:</strong>
    <%= session_jeu.pieces_jouees %>
  </p>

  <p>
    <strong>Notes session:</strong>
    <%= session_jeu.notes_session %>
  </p>

  <p>
    <strong>Ressenti epoque:</strong>
    <%= session_jeu.ressenti_epoque %>
  </p>

  <p>
    <strong>Epoque:</strong>
    <%= session_jeu.epoque.nom %>
  </p>

  <p>
    <strong>Reflexion personnelle:</strong>
    <%= session_jeu.reflexion_personnelle %>
  </p>

</div>
