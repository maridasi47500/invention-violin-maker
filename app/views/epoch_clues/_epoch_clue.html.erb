<div id="<%= dom_id epoch_clue %>">
  <p>
    <strong>Fire point:</strong>
    <%= epoch_clue.fire_point_id %>
  </p>

  <p>
    <strong>Clue type:</strong>
    <%= epoch_clue.clue_type %>
  </p>

  <p>
    <strong>Value:</strong>
    <%= epoch_clue.value %>
  </p>

  <p>
    <strong>Epoch:</strong>
    <%= epoch_clue.epoch %>
  </p>

  <p>
    <strong>Weight:</strong>
    <%= epoch_clue.weight %>
  </p>

</div>
