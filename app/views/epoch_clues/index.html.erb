<p style="color: green"><%= notice %></p>

<% content_for :title, "Epoch clues" %>

<h1>Epoch clues</h1>

<div id="epoch_clues">
  <% @epoch_clues.each do |epoch_clue| %>
    <%= render epoch_clue %>
    <p>
      <%= link_to "Show this epoch clue", epoch_clue %>
    </p>
  <% end %>
</div>

<%= link_to "New epoch clue", new_epoch_clue_path %>
