<p style="color: green"><%= notice %></p>

<%= render @question %>
Question : <%=@question.texte%>
<%=link_to "[🎙️  Enregistrer ma réponse] ", enregistrerreponse_explorations_path(question_id: @question.id)%>
<%=link_to "[✍️  Écrire en LilyPond] ", ecrirelilypond_explorations_path(question_id: @question.id)%>
