<%= form_with(model: question) do |form| %>
  <% if question.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(question.errors.count, "error") %> prohibited this question from being saved:</h2>

      <ul>
        <% question.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :texte, style: "display: block" %>
    <%= form.textarea :texte, placeholder: "Le feu est-il dans le poids ou la lenteur ?" %>
<ul>
<li>le feu est il dans l'harmonique ou le quatrieme doigt enfoncé</li>
<li>le feu est il dans le timbre de la corde à vide / dans le timbre de la corde avec les doigts en position I, II, V, VII etc</li>
<li>le feu est-il dans la longueur d'archet</li>
<li>le feu est-il dans la pression de l'archet</li>
<li>le feu est-il dans la position de l'archet près du chevalet ou près de la touche</li>
<li>le feu est il au talon au milieu ou à la pointe</li>
<li>le feu est il dans la lenteur ou la vitesse?</li>
<li>le feu est il dans la division de l'archet par rapport à la durée des notes d'une liaison</li>

</ul>
  </div>

  <div>
    <%= form.label :fire_point_id, style: "display: block" %>
    <%= form.collection_select :fire_point_id, FirePoint.all, :id, :myname %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
