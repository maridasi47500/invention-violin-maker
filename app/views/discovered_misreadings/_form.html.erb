<%= form_with(model: discovered_misreading) do |form| %>
  <% if discovered_misreading.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(discovered_misreading.errors.count, "error") %> prohibited this discovered_misreading from being saved:</h2>

      <ul>
        <% discovered_misreading.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :epoch_hypothesis_id, style: "display: block" %>
    <%= form.text_field :epoch_hypothesis_id %>
  </div>

  <div>
    <%= form.label :from_clue, style: "display: block" %>
    <%= form.text_field :from_clue %>
  </div>

  <div>
    <%= form.label :epoch_id, style: "display: block" %>
    <%= form.text_field :epoch_id %>
  </div>

  <div>
    <%= form.label :lesson, style: "display: block" %>
    <%= form.text_field :lesson %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
