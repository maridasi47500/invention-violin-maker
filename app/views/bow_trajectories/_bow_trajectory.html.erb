<div id="<%= dom_id bow_trajectory %>">
  <p>
    <strong>Bow stroke type:</strong>
    <%= bow_trajectory.bow_stroke_type %>
  </p>

  <p>
    <strong>Friction trajectory:</strong>
    <%= bow_trajectory.friction_trajectory %>
  </p>

  <p>
    <strong>Empty trajectory:</strong>
    <%= bow_trajectory.empty_trajectory %>
  </p>

  <p>
    <strong>Air time percentage:</strong>
    <%= bow_trajectory.air_time_percentage %>
  </p>

  <p>
    <strong>Resonance quality:</strong>
    <%= bow_trajectory.resonance_quality %>
  </p>

  <p>
    <strong>Tension buildup:</strong>
    <%= bow_trajectory.tension_buildup %>
  </p>

</div>
