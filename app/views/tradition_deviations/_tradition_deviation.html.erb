<div id="<%= dom_id tradition_deviation %>">
  <p>
    <strong>Fire point:</strong>
    <%= tradition_deviation.fire_point_id %>
  </p>

  <p>
    <strong>Compositeur:</strong>
    <%= tradition_deviation.compositeur_id %>
  </p>

  <p>
    <strong>Tradition says:</strong>
    <%= tradition_deviation.tradition_says %>
  </p>

  <p>
    <strong>Violinist does:</strong>
    <%= tradition_deviation.violinist_does %>
  </p>

  <p>
    <strong>Reason:</strong>
    <%= tradition_deviation.reason %>
  </p>

  <p>
    <strong>Consequence:</strong>
    <%= tradition_deviation.consequence %>
  </p>

</div>
