<div id="<%= dom_id instrument %>">
  <p>
    <strong>Brand:</strong>
    <%= instrument.brand %>
  </p>

  <p>
    <strong>Model:</strong>
    <%= instrument.model %>
  </p>

  <p>
    <strong>Year:</strong>
    <%= instrument.year %>
  </p>

  <p>
    <strong>Serial number:</strong>
    <%= instrument.serial_number %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= instrument.description %>
  </p>

</div>
