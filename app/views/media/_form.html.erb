<%= form_with(model: media) do |form| %>
  <% if media.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(media.errors.count, "error") %> prohibited this media from being saved:</h2>

      <ul>
        <% media.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :url, style: "display: block" %>
    <%= form.text_field :url %>
  </div>

  <div>
    <%= form.label :type_media, style: "display: block" %>
    <%= form.select :type_media, [["Partition","partition"],["Vidéo","video"],["Musique","musique"]] %>
  </div>

  <div>
    <%= form.label :exemple_musical_id, style: "display: block" %>
    <%= form.collection_select :exemple_musical_id,ExempleMusical.all, :id, :myname %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
