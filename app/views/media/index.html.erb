<p style="color: green"><%= notice %></p>

<% content_for :title, "Media" %>

<h1>Media</h1>

<div id="media">
  <% @media.each do |media| %>
    <%= render media %>
    <p>
      <%= link_to "Show this media", media %>
    </p>
  <% end %>
</div>
<h1>autre Media où le coup d'archet est <%=@coup_archet.nom%></h1>

<div id="autremedia">
  <% @autremedia.each do |media| %>
    <%= render media %>
    <p>
      <%= link_to "Show this media", media %>
    </p>
  <% end %>
</div>

<%= link_to "New media", new_media_path %>
