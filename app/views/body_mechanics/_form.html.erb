<%= form_with(model: body_mechanic) do |form| %>
  <% if body_mechanic.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(body_mechanic.errors.count, "error") %> prohibited this body_mechanic from being saved:</h2>

