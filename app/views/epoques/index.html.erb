<p style="color: green"><%= notice %></p>

<% content_for :title, "Epoques" %>

<h1>Epoques</h1>

<div id="epoques">
  <% @epoques.each do |epoque| %>
    <%= render epoque %>
    <p>
      <%= link_to "Show this epoque", epoque %>
    </p>
  <% end %>
</div>

<%= link_to "New epoque", new_epoque_path %>
