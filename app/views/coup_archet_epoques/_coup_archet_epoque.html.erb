<div id="<%= dom_id coup_archet_epoque %>">
  <p>
    <strong>Coup archet:</strong>
    <%= coup_archet_epoque.coup_archet_id %>
  </p>

  <p>
    <strong>Epoque:</strong>
    <%= coup_archet_epoque.epoque_id %>
  </p>

  <p>
    <strong>Description epoque:</strong>
    <%= coup_archet_epoque.description_epoque %>
