  <div>
    <%= form.label :description_epoque, style: "display: block" %>
    <%= form.textarea :description_epoque %>
  </div>

  <div>
    <%= form.label :caracteristiques_typiques, style: "display: block" %>
    <%= form.textarea :caracteristiques_typiques %>
  </div>

  <div>
    <%= form.label :evolution_depuis_precedent, style: "display: block" %>
    <%= form.textarea :evolution_depuis_precedent %>
  </div>

  <div>
    <%= form.label :raison_mutation, style: "display: block" %>
    <%= form.textarea :raison_mutation %>
  </div>

  <div>
    <%= form.label :exemples_references, style: "display: block" %>
    <%= form.textarea :exemples_references %>
  </div>

  <div>
    <%= form.label :ordre_chronologique_id, style: "display: block" %>
