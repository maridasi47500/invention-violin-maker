<%= form_with(model: coup_archet_epoque) do |form| %>
  <% if coup_archet_epoque.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(coup_archet_epoque.errors.count, "error") %> prohibited this coup_archet_epoque from being saved:</h2>

      <ul>
        <% coup_archet_epoque.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :coup_archet_id, style: "display: block" %>
