<%= form_with(model: fire_point) do |form| %>
  <% if fire_point.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(fire_point.errors.count, "error") %> prohibited this fire_point from being saved:</h2>

      <ul>
        <% fire_point.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :string_spirit_id, style: "display: block" %>
    <%= form.collection_select :string_spirit_id, StringSpirit.all, :id, :myname %>
  </div>

  <div>
    <%= form.label :coup_archet_id, style: "display: block" %>
    <%= form.collection_select :coup_archet_id, CoupArchet.all, :id, :nom %>
  </div>

  <div>
    <%= form.label :oeuvre_id, style: "display: block" %>
    <%= form.collection_select :oeuvre_id, Oeuvre.all, :id, :titre %>
  </div>
  <div>
    <%= form.label :valid_epochs, style: "display: block" %>
    <%= form.collection_select :valid_epochs, Epoque.all, :id, :nom, multiple: true %>
  </div>
  <div>
    <%= form.label :invalid_epochs, style: "display: block" %>
    <%= form.collection_select :invalid_epochs, Epoque.all, :id, :nom, multiple: true %>
  </div>
  <div>
    <%= form.label :cross_piece_validation, style: "display: block" %>
    <%= form.collection_select :cross_piece_validation, Oeuvre.all, :id, :titre,multiple: true %>
  </div>
  <div>
    <%= form.label :was_false_positive, style: "display: block" %>
    <%= form.check_box :was_false_positive %>
  </div>
  <div>
    <%= form.label :false_positive_reason, style: "display: block" %>
    <%= form.textarea :false_positive_reason %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
