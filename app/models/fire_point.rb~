class FirePoint < ApplicationRecord
  belongs_to :string_spirit
  belongs_to :coup_archet
  
  belongs_to :oeuvre
  has_many :questions
  has_many :explorations
  belongs_to :cross_piece_validation, class_name: "Oeuvre"
  accepts_nested_attributes_for :cross_piece_validation, allow_destroy: true
  accepts_nested_attributes_for :string_spirit, allow_destroy: true
  accepts_nested_attributes_for :coup_archet, allow_destroy: true
  accepts_nested_attributes_for :oeuvre, allow_destroy: true
  # Ex: "Le spirit Sol/Brahms/Romantique + Détaché lourd + Symphonie 4"
def myname
coup_archet.nom+ " "+oeuvre.titre
end
before_validation do
  x=Oeuvre.find_or_initialize_by(title: oeuvre.title, compositeur_id: oeuvre.compositeur_id) 
  if x.id.to_i > 0
    self.oeuvre=x
  end
  x=CoupArchet.find_or_initialize_by(nom: coup_archet.nom, epoque_id: coup_archet.epoque_id) 
  if x.id.to_i > 0
    self.coup_archet=x
  end

  x=Oeuvre.find_or_initialize_by(title: cross_piece_validation.title, compositeur_id: cross_piece_validation.compositeur_id) 
  if x.id.to_i > 0
    self.cross_piece_validation=x
  end
  x=StringSpirit.find_or_initialize_by(string_spirit.as_h)
  if x.id.to_i > 0
    self.string_spirit=x
  end
rescue
  p "haha"

  
end
end
